#!/usr/bin/env bash
# OpenNote Installer — fetches OpenNote from GitHub (no PyPI, no extra hosting).
# Usage:
#   macOS / Linux / Git Bash / WSL:
#     curl -fsSL https://raw.githubusercontent.com/natarmr/OpenNote/main/install | bash
#   Windows PowerShell 5.1 (curl is an alias for Invoke-WebRequest):
#     curl.exe -fsSL https://raw.githubusercontent.com/natarmr/OpenNote/main/install | bash
#     # or native PowerShell:
#     iwr -useb https://raw.githubusercontent.com/natarmr/OpenNote/main/install.ps1 | iex
# Docs: https://github.com/natarmr/OpenNote#installation
#
# NOTE: never `pip install opennote` — that PyPI name belongs to an unrelated
# video-API SDK. OpenNote installs only from the GitHub tarball below.

set -euo pipefail

TARBALL_URL="https://github.com/natarmr/OpenNote/archive/refs/heads/main.tar.gz"

# 1. Resolve Python (cross-platform: python3 / python / py launcher on Windows)
PYTHON_BIN=""
if command -v python3 &>/dev/null; then
    PYTHON_BIN="python3"
elif command -v python &>/dev/null; then
    PYTHON_BIN="python"
elif command -v py &>/dev/null; then
    PYTHON_BIN="py"
else
    echo "Python 3.10+ is required (python3/python/py not found)" >&2
    exit 1
fi

# Verify Python version >= 3.10
if ! "$PYTHON_BIN" -c "import sys; raise SystemExit(0 if sys.version_info >= (3,10) else 1)" 2>/dev/null; then
    echo "Python 3.10+ is required (found $("$PYTHON_BIN" --version 2>&1))" >&2
    exit 1
fi

# 2. Install OpenNote from the GitHub tarball (PEP 508 direct reference).
echo "Installing OpenNote..."
"$PYTHON_BIN" -m pip install "opennote @ ${TARBALL_URL}"

# 3. Verify installation (bare console script first, python -m fallback)
if command -v opennote &>/dev/null && opennote --help &>/dev/null; then
    echo "OpenNote installed successfully!"
    echo "Run: opennote --help"
elif "$PYTHON_BIN" -m opennote.cli --help &>/dev/null; then
    echo "OpenNote installed successfully! (console script not on PATH yet)"
    echo "Run: $PYTHON_BIN -m opennote.cli --help"
    echo "Tip: restart your shell or add \$HOME/.local/bin to PATH for bare 'opennote'."
else
    echo "Installation may need PATH adjustment." >&2
    echo "Try: $PYTHON_BIN -m opennote.cli --help" >&2
    exit 1
fi
